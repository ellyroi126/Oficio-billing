# Database (Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Cloudflare R2 Storage (Required for file uploads)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="oficio-billing"
R2_PUBLIC_URL="https://files.yourdomain.com"

# Email Service Configuration
# Choose your email provider: 'resend', 'gmail', or 'auto' (tries Resend first, falls back to Gmail)
EMAIL_PROVIDER="auto"

# Gmail SMTP (Recommended for quick start)
# See docs/EMAIL_SETUP_GMAIL.md for setup instructions
GMAIL_USER="info@oficiopl.com"
GMAIL_APP_PASSWORD=""

# Resend (Recommended for production)
# See docs/EMAIL_SETUP_RESEND.md for setup instructions
RESEND_API_KEY=""
RESEND_DOMAIN="resend.dev"
