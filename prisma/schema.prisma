generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String   @id @default(cuid())
  name            String
  contactPerson   String
  contactPosition String
  address         String
  emails          String[]
  mobiles         String[]
  telephone       String?
  plan            String   @default("Virtual")
  signers         Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  autoGenerateInvoices  Boolean @default(false)
  autoGenerateDay       Int     @default(1)
  autoGenerateDaysAhead Int     @default(30)
}

model Client {
  id                 String          @id @default(cuid())
  clientName         String
  address            String
  rentalRate         Float
  vatInclusive       Boolean         @default(false)
  rentalTermsMonths  Int
  billingTerms       String
  customBillingTerms String?
  leaseInclusions    String?
  startDate          DateTime
  endDate            DateTime
  status             String          @default("active")
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  contacts           ClientContact[]
  contracts          Contract[]
  invoices           Invoice[]
  payments           Payment[]
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  contactPerson   String
  contactPosition String?
  email           String?
  mobile          String?
  telephone       String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Contract {
  id              String    @id @default(cuid())
  clientId        String
  contractNumber  String    @unique
  filePath        String?
  pdfPath         String?
  status          String    @default("draft")
  startDate       DateTime
  endDate         DateTime
  signerName      String?
  signerPosition  String?
  renewalReminder DateTime?
  sentAt          DateTime?
  signedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Invoice {
  id                 String    @id @default(cuid())
  clientId           String
  invoiceNumber      String    @unique
  filePath           String?
  amount             Float
  vatAmount          Float     @default(0)
  totalAmount        Float
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  status             String    @default("pending")
  deletedAt          DateTime?
  sentAt             DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  hasWithholdingTax  Boolean   @default(false)
  netAmount          Float?
  withholdingTax     Float     @default(0)
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@index([clientId])
}

model Payment {
  id              String   @id @default(cuid())
  clientId        String
  invoiceId       String?
  amount          Float
  paymentDate     DateTime
  paymentMethod   String?
  referenceNumber String?
  evidencePath    String?
  remarks         String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  receiptPath     String?
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([clientId])
  @@index([invoiceId])
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String
  role        String    @default("EMPLOYEE")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model EmailLog {
  id           String   @id @default(cuid())
  recipient    String
  subject      String
  type         String
  status       String   @default("sent")
  sentAt       DateTime @default(now())
  errorMessage String?
}

model ApprovalRequest {
  id                String    @id @default(cuid())
  requestedBy       String
  requestedByName   String
  requestedByEmail  String
  actionType        String
  entityType        String
  entityId          String
  entityName        String?
  reason            String?
  metadata          Json?
  status            String    @default("PENDING")
  reviewedBy        String?
  reviewedByName    String?
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([requestedBy])
  @@index([status])
  @@index([actionType])
  @@index([createdAt])
}

model AuditLog {
  id                String    @id @default(cuid())
  userId            String
  userName          String
  userEmail         String
  userRole          String
  action            String
  actionCategory    String
  entityType        String?
  entityId          String?
  entityName        String?
  approvalRequestId String?
  wasApproved       Boolean   @default(false)
  beforeData        Json?
  afterData         Json?
  changesSummary    String?
  ipAddress         String?
  userAgent         String?
  reason            String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([actionCategory])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model AuthLog {
  id            String    @id @default(cuid())
  userId        String?
  email         String
  action        String
  ipAddress     String?
  userAgent     String?
  failureReason String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
